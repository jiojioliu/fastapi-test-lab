{
  "info": {
    "_postman_id": "5c722193-79a4-4435-a719-22868f8b81c8",
    "name": "FastAPI Test Lab",
    "description": "A complete functional workflow for the local FastAPI Test Lab. Run the collection in order, or start with Authentication / Login to populate access_token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 · Authentication",
      "item": [
        {
          "name": "Login and capture JWT",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('response has a request ID', () => pm.response.to.have.header('X-Request-ID'));",
                  "const body = pm.response.json();",
                  "pm.test('access token is returned', () => pm.expect(body.access_token).to.be.a('string').and.not.empty);",
                  "pm.collectionVariables.set('access_token', body.access_token);",
                  "pm.collectionVariables.set('user_id', String(body.user.id));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Training-Source",
                "value": "postman"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Logs in as the seeded administrator test account and stores the Bearer JWT in the collection variable access_token."
          },
          "response": []
        },
        {
          "name": "Current account",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('username is admin', () => pm.expect(pm.response.json().username).to.eql('admin'));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Login with a wrong password (negative)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('Bearer challenge is present', () => pm.response.to.have.header('WWW-Authenticate'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"wrong-password\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "02 · Catalog",
      "item": [
        {
          "name": "Search and sort products",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('there are matching products', () => pm.expect(body.items.length).to.be.above(0));",
                  "pm.collectionVariables.set('product_id', String(body.items[0].id));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products?search=keyboard&sort=price_asc&page=1&page_size=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "keyboard"
                },
                {
                  "key": "sort",
                  "value": "price_asc"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "page_size",
                  "value": "10"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Read one product",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('product has stock', () => pm.expect(pm.response.json().stock).to.be.a('number'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/{{product_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products",
                "{{product_id}}"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "03 · Orders",
      "item": [
        {
          "name": "Create order with idempotency key",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('order is confirmed', () => pm.expect(body.status).to.eql('confirmed'));",
                  "pm.test('payment is recorded', () => pm.expect(body.payment_method).to.eql('alipay'));",
                  "pm.test('payment is paid', () => pm.expect(body.payment_status).to.eql('paid'));",
                  "pm.collectionVariables.set('order_id', body.id);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "postman-{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"product_id\": {{product_id}},\n      \"quantity\": 1\n    }\n  ],\n  \"note\": \"Created from the Postman collection\",\n  \"payment_method\": \"alipay\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            }
          },
          "response": []
        },
        {
          "name": "List my orders",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('at least one order exists', () => pm.expect(pm.response.json().total).to.be.above(0));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/orders?page=1&page_size=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "page_size",
                  "value": "20"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Read created order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('owner has access', () => pm.expect(pm.response.json().username).to.eql('admin'));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{order_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders",
                "{{order_id}}"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "04 · Network Lab",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{access_token}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Observe an echoed request",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('custom header is echoed', () => pm.expect(pm.response.json().headers['x-postman-exercise']).to.eql('network-inspection'));",
                  "pm.test('request ID is echoed', () => pm.expect(pm.response.json().request_id).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Postman-Exercise",
                "value": "network-inspection"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Inspect me in Burp and Wireshark\",\n  \"tool\": \"postman\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/lab/echo?source=postman&lesson=observation",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "lab",
                "echo"
              ],
              "query": [
                {
                  "key": "source",
                  "value": "postman"
                },
                {
                  "key": "lesson",
                  "value": "observation"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Slow response",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('response took at least 800 ms', () => pm.expect(pm.response.responseTime).to.be.above(800));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/lab/slow?delay_ms=1000",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "lab",
                "slow"
              ],
              "query": [
                {
                  "key": "delay_ms",
                  "value": "1000"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Selected status code",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is deliberately 500', () => pm.response.to.have.status(500));",
                  "pm.test('error body identifies the simulation', () => pm.expect(pm.response.json().simulated_status).to.eql(500));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/lab/status/500",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "lab",
                "status",
                "500"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Multipart upload",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('SHA-256 is returned', () => pm.expect(pm.response.json().sha256).to.have.lengthOf(64));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "sample-upload.txt",
                  "description": "Select downloads/sample-upload.txt from this project."
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/lab/upload",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "lab",
                "upload"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "05 · Observability",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{access_token}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Read traffic summary",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('metrics include latency percentiles', () => pm.expect(pm.response.json().summary).to.have.property('p95_latency_ms'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/traffic/summary?recent_limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "traffic",
                "summary"
              ],
              "query": [
                {
                  "key": "recent_limit",
                  "value": "20"
                }
              ]
            }
          },
          "response": []
        }
      ]
    }
  ],
  "auth": {
    "type": "noauth"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": []
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": []
      }
    }
  ],
